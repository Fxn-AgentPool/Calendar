# Settings for docker compose. This file is committed: ports and other
# non-secret settings only. Passwords, key hashes and your username live in
# secrets/*.env (not committed; templates in secrets/*.env.example).

# --- Ports on this machine ----------------------------------------------------
# Services listen on BIND_ADDRESS only. 127.0.0.1 = reachable from this machine
# (Newt running on the host, local scripts), not from the network. A Newt
# container on the "calendar" network doesn't need these ports at all.
BIND_ADDRESS=127.0.0.1
RADICALE_PORT=5232      # CalDAV            -> Pangolin resource cal.<domain>
INGEST_PORT=8000        # ingest API        -> Pangolin resource ingest.<domain>
AGENDA_PORT=8001        # agenda web view   -> Pangolin resource agenda.<domain>
LLM_PORT=8080           # llama.cpp (extraction), local only: scripts/bench_llm.py
CHECKER_PORT=8082       # llama.cpp (Kev-4B checker), local only

# --- Models (files in models/, see scripts/download_model.sh) -----------------
LLM_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
CHECKER_MODEL_FILE=Kev-4B-Q4_K_M.gguf
LLM_THREADS=6           # physical CPU cores work best
LLM_CTX_SIZE=8192

# --- Ingest behaviour ----------------------------------------------------------
INGEST_CALENDAR=personal          # calendar new events go into
DEFAULT_EVENT_MINUTES=60          # length of events without an end time
INGEST_RATE_LIMIT_PER_HOUR=30
INGEST_ALL_DAY_CONFLICTS=false    # true: all-day events also count as conflicts
CHECKER_URL=http://checker:8080   # empty: no confidence check
CHECK_THRESHOLD=0.5               # below: added as "(?)" and queued for review

# --- Agenda view -----------------------------------------------------------------
AGENDA_DAYS=14
