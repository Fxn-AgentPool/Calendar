# Copy to secrets/ingest.env (or let the scripts fill it in). Used by ingest only.
# Password of the Radicale "ingest" account: scripts/radicale-passwd.sh ingest
CALDAV_PASSWORD=
# SHA-256 of the API key for clients: scripts/new_api_key.sh ingest
INGEST_API_KEY_HASH=
# SHA-256 of the desktop review helper's key: scripts/new_api_key.sh helper
# (empty = review endpoints off)
HELPER_API_KEY_HASH=
