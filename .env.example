# Copy to .env and fill in. .env is not committed.

# Your calendar username: lowercase letters, digits, "-" or "_".
# Must not be "ingest" or "agenda" (service accounts).
CAL_USER=me

# Your time zone (IANA name), used by later services.
USER_TIMEZONE=Europe/Berlin

# Ingest API.
# Password of the Radicale "ingest" account (from scripts/radicale-passwd.sh ingest).
INGEST_CALDAV_PASSWORD=
# SHA-256 of the API key (from scripts/new_api_key.sh).
INGEST_API_KEY_HASH=
# Calendar that new events go into, and length of events without an end time.
INGEST_CALENDAR=personal
DEFAULT_EVENT_MINUTES=60
INGEST_RATE_LIMIT_PER_HOUR=30

# Agenda web view.
# Password of the Radicale "agenda" account (from scripts/radicale-passwd.sh agenda).
AGENDA_CALDAV_PASSWORD=
# Optional second login inside the app (on top of Pangolin's), username = CAL_USER.
# Create with: docker compose run --rm --no-deps web python -m calapp.web.hashpw
AGENDA_PASSWORD_HASH=
AGENDA_DAYS=14

# LLM: file name inside models/ (scripts/download_model.sh prints it).
LLM_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# Physical CPU cores (not threads) work best.
LLM_THREADS=6
LLM_CTX_SIZE=8192

# Only if Newt runs from this compose file (--profile newt).
# Values come from the Pangolin dashboard when you add a site.
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=
NEWT_SECRET=
