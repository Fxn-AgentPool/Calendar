# Copy to .env and fill in. .env is not committed.

# Your calendar username: lowercase letters, digits, "-" or "_".
# Must not be "ingest" or "agenda" (service accounts).
CAL_USER=me

# Your time zone (IANA name), used by later services.
USER_TIMEZONE=Europe/Berlin

# Only if Newt runs from this compose file (--profile newt).
# Values come from the Pangolin dashboard when you add a site.
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=
NEWT_SECRET=
